@page
@using CAHFS.GraphQl
@model CAHFS_Recharges.Pages.ApiValidationModel
@{
    ViewData["Title"] = "AE API Validation";

    var apiInfo = ViewData["ErpApiInfo"] as ErpApiInfoResult;
    var apiInfoErrors = ViewData["ErpApiInfoErrors"] as List<string>;

    var input1 = ViewData["ErpChartValidation1Input"] as string;
    var input2 = ViewData["ErpChartValidation2Input"] as string;

    // NOTE: these types are generated by StrawberryShake based on query name.
    // If interface names differ slightly, change IErpValidateChartstringResult accordingly.
    var chart1 = ViewData["ErpChartValidation1"] as IErpValidateChartstringResult;
    var chart1Errors = ViewData["ErpChartValidation1Errors"] as List<string>;

    var chart2 = ViewData["ErpChartValidation2"] as IErpValidateChartstringResult;
    var chart2Errors = ViewData["ErpChartValidation2Errors"] as List<string>;
}

<h1>AE API Validation</h1>

<form method="get" class="mb-3">
    <div class="row">
        <div class="col-md-6">
            <label class="form-label">Chart 1</label>
            <input class="form-control" name="Chart1" value="@Model.Chart1" />
        </div>
        <div class="col-md-6">
            <label class="form-label">Chart 2</label>
            <input class="form-control" name="Chart2" value="@Model.Chart2" />
        </div>
    </div>
    <button type="submit" class="btn btn-primary mt-2">Validate</button>
</form>

<div class="mb-3">
    @if (apiInfo != null)
    {
        <div><strong>Aggie Enterprise API Version #:</strong> @apiInfo.ErpApiInfo.VersionNumber</div>
    }
    else
    {
        <div><strong>No API Info</strong></div>
    }

    @if (apiInfoErrors != null && apiInfoErrors.Any())
    {
        <div class="mt-2"><strong>API Info GraphQL Errors:</strong></div>
        <ul>
            @foreach (var e in apiInfoErrors)
            {
                <li>@e</li>
            }
        </ul>
    }
</div>

<hr />

@* ===========================
   CHART 1
=========================== *@
<div class="mb-3">
    <h4>Chart String 1</h4>

    @if (!string.IsNullOrWhiteSpace(input1))
    {
        <div class="text-muted"><strong>Input:</strong> @input1</div>
    }

    @if (chart1Errors != null && chart1Errors.Any())
    {
        <div class="alert alert-danger">
            <strong>GraphQL Errors:</strong>
            <ul class="mb-0">
                @foreach (var e in chart1Errors)
                {
                    <li>@e</li>
                }
            </ul>
        </div>
    }

    @if (chart1 != null)
    {
        var d = chart1.ErpValidateChartstring;

        <div><strong>Valid:</strong> @d.ValidationResponse.Valid</div>
        <div><strong>Chartstring:</strong> @d.Chartstring</div>

        @if (d.ValidationResponse.ErrorMessages != null && d.ValidationResponse.ErrorMessages.Any())
        {
            <div class="mt-2"><strong>Validation ErrorMessages:</strong></div>
            <ul>
                @foreach (var e in d.ValidationResponse.ErrorMessages)
                {
                    <li>@e</li>
                }
            </ul>
        }

        @* GL Segments *@
        @if (d.Segments != null)
        {
            <div class="mt-3"><strong>GL Segments:</strong></div>
            <ul class="mb-0">
                <li>Entity: @d.Segments.Entity</li>
                <li>Fund: @d.Segments.Fund</li>
                <li>Department: @d.Segments.Department</li>
                <li>Account: @d.Segments.Account</li>
                <li>Purpose: @d.Segments.Purpose</li>
                <li>Project: @d.Segments.Project</li>
                <li>Program: @d.Segments.Program</li>
                <li>Activity: @d.Segments.Activity</li>
            </ul>
        }

        @* PPM Segments *@
        @if (d.PpmSegments != null)
        {
            <div class="mt-3"><strong>PPM Segments:</strong></div>
            <ul class="mb-0">
                <li>Project: @d.PpmSegments.Project</li>
                <li>Task: @d.PpmSegments.Task</li>
                <li>Organization: @d.PpmSegments.Organization</li>
                <li>ExpenditureType: @d.PpmSegments.ExpenditureType</li>
                <li>Award: @d.PpmSegments.Award</li>
                <li>FundingSource: @d.PpmSegments.FundingSource</li>
            </ul>
        }

        @if (d.Warnings != null && d.Warnings.Any())
        {
            <div class="mt-3"><strong>Warnings:</strong></div>
            <ul>
                @foreach (var w in d.Warnings)
                {
                    <li>@w.SegmentName : @w.Warning</li>
                }
            </ul>
        }

        @if (d.EndDates != null && d.EndDates.Any())
        {
            <div class="mt-3"><strong>End Dates:</strong></div>
            <ul>
                @foreach (var ed in d.EndDates)
                {
                    <li>@ed.SegmentName : @ed.EndDate</li>
                }
            </ul>
        }

        @if (d.CodeCombinationId != null)
        {
            <div class="mt-3"><strong>CodeCombinationId:</strong> @d.CodeCombinationId</div>
        }
    }
    else
    {
        <div class="text-muted">No data (enter Chart1 above and click Validate)</div>
    }
</div>

<hr />

@* ===========================
   CHART 2
=========================== *@
<div class="mb-3">
    <h4>Chart String 2</h4>

    @if (!string.IsNullOrWhiteSpace(input2))
    {
        <div class="text-muted"><strong>Input:</strong> @input2</div>
    }

    @if (chart2Errors != null && chart2Errors.Any())
    {
        <div class="alert alert-danger">
            <strong>GraphQL Errors:</strong>
            <ul class="mb-0">
                @foreach (var e in chart2Errors)
                {
                    <li>@e</li>
                }
            </ul>
        </div>
    }

    @if (chart2 != null)
    {
        var d = chart2.ErpValidateChartstring;

        <div><strong>Valid:</strong> @d.ValidationResponse.Valid</div>
        <div><strong>Chartstring:</strong> @d.Chartstring</div>

        @if (d.ValidationResponse.ErrorMessages != null && d.ValidationResponse.ErrorMessages.Any())
        {
            <div class="mt-2"><strong>Validation ErrorMessages:</strong></div>
            <ul>
                @foreach (var e in d.ValidationResponse.ErrorMessages)
                {
                    <li>@e</li>
                }
            </ul>
        }

        @if (d.Segments != null)
        {
            <div class="mt-3"><strong>GL Segments:</strong></div>
            <ul class="mb-0">
                <li>Entity: @d.Segments.Entity</li>
                <li>Fund: @d.Segments.Fund</li>
                <li>Department: @d.Segments.Department</li>
                <li>Account: @d.Segments.Account</li>
                <li>Purpose: @d.Segments.Purpose</li>
                <li>Project: @d.Segments.Project</li>
                <li>Program: @d.Segments.Program</li>
                <li>Activity: @d.Segments.Activity</li>
            </ul>
        }

        @if (d.PpmSegments != null)
        {
            <div class="mt-3"><strong>PPM Segments:</strong></div>
            <ul class="mb-0">
                <li>Project: @d.PpmSegments.Project</li>
                <li>Task: @d.PpmSegments.Task</li>
                <li>Organization: @d.PpmSegments.Organization</li>
                <li>ExpenditureType: @d.PpmSegments.ExpenditureType</li>
                <li>Award: @d.PpmSegments.Award</li>
                <li>FundingSource: @d.PpmSegments.FundingSource</li>
            </ul>
        }

        @if (d.Warnings != null && d.Warnings.Any())
        {
            <div class="mt-3"><strong>Warnings:</strong></div>
            <ul>
                @foreach (var w in d.Warnings)
                {
                    <li>@w.SegmentName : @w.Warning</li>
                }
            </ul>
        }

        @if (d.EndDates != null && d.EndDates.Any())
        {
            <div class="mt-3"><strong>End Dates:</strong></div>
            <ul>
                @foreach (var ed in d.EndDates)
                {
                    <li>@ed.SegmentName : @ed.EndDate</li>
                }
            </ul>
        }

        @if (d.CodeCombinationId != null)
        {
            <div class="mt-3"><strong>CodeCombinationId:</strong> @d.CodeCombinationId</div>
        }
    }
    else
    {
        <div class="text-muted">No data (enter Chart2 above and click Validate)</div>
    }
</div>
