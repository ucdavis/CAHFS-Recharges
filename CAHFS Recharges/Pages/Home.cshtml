@page
@model CAHFS_Recharges.Pages.HomeModel
@{
    ViewData["Title"] = "Select Integration";
}

<div class="caei-home">
    <h1 class="visually-hidden">Select Integration</h1>
    <div class="caei-home-welcome">
        <h2>Welcome, <span class="caei-data-key">@Model.FirstName</span></h2>
        <p class="text-muted mb-0">Select an integration to begin working</p>
    </div>

<section class="caei-home-section" aria-labelledby="ae-workspaces">
    <h2 id="ae-workspaces" class="h5 caei-data-key caei-home-section-title">Aggie Enterprise Integration</h2>
    <div class="caei-home-grid">
            <article class="card caei-workspace-card h-100 cahfs-theme">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="caei-workspace-mark" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.5 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7Zm.5-5v1h1a.5.5 0 0 1 0 1h-1v1a.5.5 0 0 1-1 0v-1h-1a.5.5 0 0 1 0-1h1v-1a.5.5 0 0 1 1 0Z"/>
                                <path d="M2 1a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v6.5a.5.5 0 0 1-1 0V1H3v14h3a.5.5 0 0 1 0 1H2a1 1 0 0 1-1-1V1Z"/>
                                <path d="M4 3a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H4Zm0 2.5a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H4Zm0 2.5a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H4Z"/>
                            </svg>
                        </div>
                        <span class="status-indicator text-muted small">
                            <span class="status-indicator-dot success" aria-hidden="true"></span>
                            Active
                        </span>
                    </div>
                    <h3 class="h5 caei-data-key">CAHFS</h3>
                    <p class="text-muted small mb-3">California Animal Health &amp; Food Safety Laboratory</p>
                    <form method="post" asp-page-handler="SelectIntegration" class="mt-auto">
                        <input type="hidden" name="integration" value="CAHFS" />
                        <input type="hidden" name="family" value="AE" />
                        <button type="submit" class="btn btn-primary w-100 caei-data-key">
                            Open CAHFS
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </article>
            <article class="card caei-workspace-card h-100 equine-theme">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="caei-workspace-mark" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 16a2 2 0 0 0 2-2H6a2 2 0 0 0 2 2zM.146 10.146a.5.5 0 0 1 .708 0L2 11.293V7a6 6 0 1 1 12 0v4.293l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 .708-.708L13 11.293V7a5 5 0 0 0-10 0v4.293l1.146-1.147a.5.5 0 0 1 .708.708l-2 2a.5.5 0 0 1-.708 0l-2-2a.5.5 0 0 1 0-.708z"/>
                            </svg>
                        </div>
                        <span class="status-indicator text-muted small">
                            <span class="status-indicator-dot success" aria-hidden="true"></span>
                            Active
                        </span>
                    </div>
                    <h3 class="h5 caei-data-key">EACL</h3>
                    <p class="text-muted small mb-3">Equine Analytical Chemistry Laboratory</p>
                    <form method="post" asp-page-handler="SelectIntegration" class="mt-auto">
                        <input type="hidden" name="integration" value="EQUINE" />
                        <input type="hidden" name="family" value="AE" />
                        <button type="submit" class="btn btn-primary w-100 caei-data-key">
                            Open EACL
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </article>
    </div>
</section>

<section class="caei-home-section" aria-labelledby="lockbox-workspaces">
    <h2 id="lockbox-workspaces" class="h5 caei-data-key caei-home-section-title">Bank of America Lockbox Integration</h2>
    <div class="caei-home-grid">
            <article class="card caei-workspace-card h-100 cahfs-theme">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="caei-workspace-mark caei-lockbox" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                                <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4zm2 1v6h12V5H2z"/>
                            </svg>
                        </div>
                        <span class="status-indicator text-muted small">
                            <span class="status-indicator-dot success" aria-hidden="true"></span>
                            Active
                        </span>
                    </div>
                    <h3 class="h5 caei-data-key">CAHFS Lockbox</h3>
                    <p class="text-muted small mb-3">PO Box 744833</p>
                    <form method="post" asp-page-handler="SelectIntegration" class="mt-auto">
                        <input type="hidden" name="integration" value="CAHFS" />
                        <input type="hidden" name="family" value="Lockbox" />
                        <button type="submit" class="btn btn-primary w-100 caei-data-key caei-lockbox">
                            Open Lockbox
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </article>
            <article class="card caei-workspace-card h-100 equine-theme">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="caei-workspace-mark caei-lockbox" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M8 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4z"/>
                                <path d="M0 4a1 1 0 0 1 1-1h14a1 1 0 0 1 1 1v8a1 1 0 0 1-1 1H1a1 1 0 0 1-1-1V4zm2 1v6h12V5H2z"/>
                            </svg>
                        </div>
                        <span class="status-indicator text-muted small">
                            <span class="status-indicator-dot success" aria-hidden="true"></span>
                            Active
                        </span>
                    </div>
                    <h3 class="h5 caei-data-key">EACL Lockbox</h3>
                    <p class="text-muted small mb-3">PO Box 744835</p>
                    <form method="post" asp-page-handler="SelectIntegration" class="mt-auto">
                        <input type="hidden" name="integration" value="EQUINE" />
                        <input type="hidden" name="family" value="Lockbox" />
                        <button type="submit" class="btn btn-primary w-100 caei-data-key caei-lockbox">
                            Open Lockbox
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </article>
    </div>
</section>

<section class="caei-home-section" aria-labelledby="hiwu-workspaces">
    <h2 id="hiwu-workspaces" class="h5 caei-data-key caei-home-section-title">HIWU Integration</h2>
    <div class="caei-home-grid">
            <article class="card caei-workspace-card h-100 equine-theme">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex align-items-start justify-content-between mb-3">
                        <div class="caei-workspace-mark" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M5 4a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zm0 2.5a.5.5 0 0 0 0 1h6a.5.5 0 0 0 0-1H5zM5 9a.5.5 0 0 0 0 1h3a.5.5 0 0 0 0-1H5z"/>
                                <path d="M2 2a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2zm10-1H4a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1z"/>
                            </svg>
                        </div>
                        <span class="status-indicator text-muted small">
                            <span class="status-indicator-dot success" aria-hidden="true"></span>
                            Active
                        </span>
                    </div>
                    <h3 class="h5 caei-data-key">EACL HIWU</h3>
                    <p class="text-muted small mb-3">HIWU manifest files for Equine Analytical Chemistry Laboratory</p>
                    <form method="post" asp-page-handler="SelectIntegration" class="mt-auto">
                        <input type="hidden" name="integration" value="EQUINE" />
                        <input type="hidden" name="family" value="Hiwu" />
                        <button type="submit" class="btn btn-primary w-100 caei-data-key">
                            Open HIWU
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                            </svg>
                        </button>
                    </form>
                </div>
            </article>
    </div>
</section>

<section class="caei-home-info" aria-labelledby="getting-started">
    <div class="caei-workspace-mark" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
    </div>
    <div>
        <h2 id="getting-started" class="h5 caei-data-key">Getting Started</h2>
        <p class="text-muted small">Select the lab and integration type for your work. Each workspace opens with tools specific to that system.</p>
        <ul class="small text-muted mb-0">
            <li><span class="caei-data-key">Aggie Enterprise (CAHFS or EACL):</span> Review staged billing data, fix COA validation errors, send journals to Aggie Enterprise, and view submission history.</li>
            <li><span class="caei-data-key">Bank of America Lockbox (CAHFS or EACL):</span> Review daily lockbox files, match checks to Great Plains invoices, post payments, and view payment history.</li>
            <li><span class="caei-data-key">HIWU (EACL):</span> Review downloaded HIWU manifest files, open a file, and download the raw XML or the HIWU CSV.</li>
        </ul>
    </div>
</section>
</div>
