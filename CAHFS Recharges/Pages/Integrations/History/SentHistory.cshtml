@page "/Integrations/{integration}/History/SentHistory"
@model CAHFS_Recharges.Pages.Integrations.History.SentHistoryModel
@{
    ViewData["Title"] = "Sent History";
    var integration = ViewData["Integration"] as string ?? "CAHFS";
    
    // Calculate stats from SentBatches
    var totalCount = Model.SentBatches.Count;
    var successCount = Model.SentBatches.Count(b => b.Status == "Completed" || b.Status == "Validated" || b.Status == "Success");
    var rejectedCount = Model.SentBatches.Count(b => b.Status == "Error" || b.Status == "Rejected" || b.Status == "Failed");
}

@* ===== ITEMS PREVIEW (full-screen overlay like Send to AE) ===== *@
@if (Model.PreviewBatchId.HasValue)
{
    var previewBatch = Model.SentBatches.FirstOrDefault(b => b.BatchId == Model.PreviewBatchId.Value);
    <div id="items-preview"
         class="caei-send-overlay"
         role="dialog"
         aria-modal="true"
         aria-labelledby="items-preview-title">
        <div class="caei-items-overlay">
            <div class="caei-items-overlay-header d-flex align-items-center justify-content-between">
                <div>
                    <h5 id="items-preview-title" class="mb-0 fw-semibold text-gray-900">
                        Items for @(previewBatch?.JournalName ?? $"Batch {Model.PreviewBatchId}")
                    </h5>
                    <p class="mb-0 text-muted small">@Model.PreviewItems.Count item(s)</p>
                </div>
                <a href="@Url.Page(null, new {
                        integration,
                        StartDate = Model.StartDate?.ToString("yyyy-MM-dd"),
                        EndDate = Model.EndDate?.ToString("yyyy-MM-dd"),
                        StatusFilter = Model.StatusFilter,
                        JournalFilter = Model.JournalFilter,
                        BatchIdFilter = Model.BatchIdFilter,
                        RequestIdFilter = Model.RequestIdFilter,
                        ExpandedBatchId = Model.ExpandedBatchId
                    })"
                   class="btn btn-sm btn-outline-secondary"
                   aria-label="Close items preview">
                    ✕
                </a>
            </div>
            <div class="caei-items-overlay-body">
                <div class="caei-items-overlay-toolbar">
                    <form class="d-flex gap-2" method="get">
                        <input type="hidden" name="integration" value="@integration" />
                        <input type="hidden" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                        <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                        <input type="hidden" name="JournalFilter" value="@Model.JournalFilter" />
                        <input type="hidden" name="BatchIdFilter" value="@Model.BatchIdFilter" />
                        <input type="hidden" name="RequestIdFilter" value="@Model.RequestIdFilter" />
                        <input type="hidden" name="ExpandedBatchId" value="@Model.ExpandedBatchId" />
                        <input type="hidden" name="PreviewBatchId" value="@Model.PreviewBatchId" />

                        <label for="itemsSearchInput" class="visually-hidden">Search items</label>
                        <input type="search"
                               id="itemsSearchInput"
                               name="PreviewSearch"
                               class="form-control form-control-sm"
                               value="@Model.PreviewSearch"
                               placeholder="Search items (any column)..." />
                        <button type="submit"
                                class="btn btn-primary btn-sm">
                            Search
                        </button>
                        <a href="@Url.Page(null, new {
                                integration,
                                StartDate = Model.StartDate?.ToString("yyyy-MM-dd"),
                                EndDate = Model.EndDate?.ToString("yyyy-MM-dd"),
                                StatusFilter = Model.StatusFilter,
                                JournalFilter = Model.JournalFilter,
                                BatchIdFilter = Model.BatchIdFilter,
                                RequestIdFilter = Model.RequestIdFilter,
                                ExpandedBatchId = Model.ExpandedBatchId,
                                PreviewBatchId = Model.PreviewBatchId
                            })"
                           class="btn btn-outline-secondary btn-sm">
                            Reset
                        </a>
                    </form>
                </div>
                <div class="table-responsive caei-scroll-y-500">
                    <table class="table table-hover mb-0 caei-table-sm caei-thead-bg caei-table-th" id="itemsPreviewTable">
                        <thead class="sticky-top bg-white">
                            <tr>
                                <th scope="col">Record ID</th>
                                <th scope="col">Original Doc #</th>
                                <th scope="col">Debit Chart</th>
                                <th scope="col">Credit Chart</th>
                                <th scope="col">Txn Date</th>
                                <th scope="col">Qty</th>
                                <th scope="col">Unit Price</th>
                                <th scope="col">Total Charge</th>
                                <th scope="col">Client ID</th>
                                <th scope="col">System ID</th>
                                <th scope="col">Debit Valid?</th>
                                <th scope="col">Credit Valid?</th>
                                <th scope="col">Test Code</th>
                                <th scope="col">Test Name</th>
                                <th scope="col">Unprocessed COA</th>
                                <th scope="col">AE Details</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var i in Model.PreviewItems)
                        {
                            var debitStatus = (i.DebitStringValid ?? "").Trim();
                            var creditStatus = (i.CreditStringValid ?? "").Trim();
                            var debitInvalid = debitStatus.Equals("Invalid", StringComparison.OrdinalIgnoreCase);
                            var creditInvalid = creditStatus.Equals("Invalid", StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td class="font-mono">@i.RecordID</td>
                                <td>@i.OrignalDocNumber</td>
                                <td class="font-mono small">@i.DebitChartString</td>
                                <td class="font-mono small">@i.CreditChartString</td>
                                <td>@(i.TransactionDate == default ? "" : i.TransactionDate.ToString("yyyy-MM-dd"))</td>
                                <td>@i.Quantity</td>
                                <td class="text-end">@(i.UnitPrice?.ToString("N2"))</td>
                                <td class="text-end">@i.TotalCharge.ToString("N2")</td>
                                <td>@i.ClientID</td>
                                <td>@i.SystemID</td>
                                <td>@debitStatus</td>
                                <td>@creditStatus</td>
                                <td>@i.TestCode</td>
                                <td>@i.TestName</td>
                                <td class="font-mono small">@i.UnprocessedCOAString</td>
                                <td class="caei-cell-wrap">
                                    @if (debitInvalid)
                                    {
                                        <div class="text-danger small">
                                            <strong>D:</strong>
                                            @(!string.IsNullOrWhiteSpace(i.DebitValidationError) ? i.DebitValidationError : "Invalid (no error text)")
                                        </div>
                                    }
                                    @if (creditInvalid)
                                    {
                                        <div class="text-danger small">
                                            <strong>C:</strong>
                                            @(!string.IsNullOrWhiteSpace(i.CreditValidationError) ? i.CreditValidationError : "Invalid (no error text)")
                                        </div>
                                    }
                                    @if (!debitInvalid && !creditInvalid)
                                    {
                                        <span class="text-muted small">-</span>
                                    }
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<div class="p-4">
    @* ===== PAGE HEADER ===== *@
    <div class="mb-4">
        <h1 class="fw-bold mb-1 caei-heading-page">Sent History</h1>
        <p class="mb-0 text-muted">View complete history of @integration batches sent to Aggie Enterprise</p>
    </div>

    @* Success/Error/Info Messages (global flash pattern) *@
    @if (!string.IsNullOrEmpty(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(Model.InfoMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.InfoMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* ===== SUMMARY CARDS (match Staging / COA Validations: staging-stats-grid + staging-stat-card) ===== *@
    <div class="staging-stats-grid mb-4">
        <div class="staging-stat-card">
            <div class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-muted"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                <span class="staging-stat-value">@totalCount</span>
            </div>
            <div class="staging-stat-label">Total Sent</div>
        </div>

        <div class="staging-stat-card has-success">
            <div class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span class="staging-stat-value text-success">@successCount</span>
            </div>
            <div class="staging-stat-label">Successful</div>
        </div>

        <div class="staging-stat-card has-warning">
            <div class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-danger"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span class="staging-stat-value text-danger">@rejectedCount</span>
            </div>
            <div class="staging-stat-label">Rejected</div>
        </div>

    </div>

    @* ===== FILTERS CARD ===== *@
    <div class="card mb-4 border caei-card-lg">
        <div class="card-header bg-white border-bottom caei-card-header-tight">
            <h5 class="mb-0 fw-semibold text-gray-900">Filters</h5>
        </div>
        <div class="card-body caei-card-body-tight">
            <form method="get">
                <input type="hidden" name="integration" value="@integration" />
                <div class="row g-4 align-items-end">
                    <div class="col">
                        <label for="filter-start-date" class="form-label small mb-2 caei-label">From Date</label>
                        <input type="date" id="filter-start-date" class="form-control caei-control-radius" name="StartDate" 
                               value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col">
                        <label for="filter-end-date" class="form-label small mb-2 caei-label">To Date</label>
                        <input type="date" id="filter-end-date" class="form-control caei-control-radius" name="EndDate" 
                               value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="col">
                        <label for="filter-status" class="form-label small mb-2 caei-label">Status</label>
                        <select class="form-select caei-control-radius" name="StatusFilter" id="filter-status">
                            @foreach (var status in Model.AvailableStatuses)
                            {
                                if (Model.StatusFilter == status)
                                {
                                    <option value="@status" selected>@(status == "All" ? "All Statuses" : status)</option>
                                }
                                else
                                {
                                    <option value="@status">@(status == "All" ? "All Statuses" : status)</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="col">
                        <label for="filter-journal" class="form-label small mb-2 caei-label">Journal Name</label>
                        <input type="text" id="filter-journal" class="form-control caei-control-radius" name="JournalFilter" 
                               value="@Model.JournalFilter" placeholder="All Journals" />
                    </div>
                    <div class="col">
                        <button type="submit" class="btn w-100 caei-btn-filter">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                            Apply Filters
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* ===== BATCH HISTORY TABLE CARD ===== *@
    <div class="card border caei-card-lg">
        <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between caei-card-header-tight">
            <h5 class="mb-0 fw-semibold text-gray-900">Batch History</h5>
            <form method="post" asp-page-handler="Export" class="d-inline">
                <input type="hidden" name="Integration" value="@integration" />
                <input type="hidden" name="StartDate" value="@Model.StartDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="EndDate" value="@Model.EndDate?.ToString("yyyy-MM-dd")" />
                <input type="hidden" name="StatusFilter" value="@Model.StatusFilter" />
                <input type="hidden" name="JournalFilter" value="@Model.JournalFilter" />
                <input type="hidden" name="BatchIdFilter" value="@Model.BatchIdFilter" />
                <input type="hidden" name="RequestIdFilter" value="@Model.RequestIdFilter" />
                <button type="submit" class="btn btn-outline-secondary caei-control-radius" @(totalCount == 0 ? "disabled" : "")>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Export History
                </button>
            </form>
        </div>

        <div class="card-body p-0">
            @if (Model.SentBatches.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0 caei-table-sm caei-thead-bg caei-table-th">
                        <thead>
                            <tr>
                                <th scope="col" style="width: 50px;"></th>
                                <th scope="col">Batch ID</th>
                                <th scope="col">Date</th>
                                <th scope="col">Journal</th>
                                <th scope="col">Accounting Date</th>
                                <th scope="col">Period</th>
                                <th scope="col" class="text-end">Total</th>
                                <th scope="col">Items</th>
                                <th scope="col">Status</th>
                                <th scope="col">Request ID</th>
                                <th scope="col">Sent At</th>
                                <th scope="col">Sent By</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var batch in Model.SentBatches)
                            {
                                var isExpanded = Model.ExpandedBatchId == batch.BatchId;
                                var statusLower = batch.Status?.ToLower() ?? "";
                                
                                var statusBadgeClass = statusLower switch
                                {
                                    "success" or "completed" or "validated" => "caei-badge-inline-success",
                                    "rejected" or "error" or "failed" => "caei-badge-inline-error",
                                    "pending" or "sent" or "processing" => "caei-badge-inline-pending",
                                    _ => "caei-badge-inline-default"
                                };
                                
                                // Status icon color
                                var statusIconColor = statusLower switch
                                {
                                    "success" or "completed" or "validated" => "#16a34a",
                                    "rejected" or "error" or "failed" => "#dc2626",
                                    "pending" or "sent" or "processing" => "#ca8a04",
                                    _ => "#6b7280"
                                };

                                var expandHref = "/Integrations/" + integration + "/History/SentHistory?StartDate=" + Model.StartDate?.ToString("yyyy-MM-dd") + "&EndDate=" + Model.EndDate?.ToString("yyyy-MM-dd") + "&StatusFilter=" + (Model.StatusFilter ?? "") + "&JournalFilter=" + (Model.JournalFilter ?? "") + "&ExpandedBatchId=" + (isExpanded ? "" : batch.BatchId.ToString()) + (isExpanded ? "" : "#batch-" + batch.BatchId.ToString());
                                <tr id="batch-@batch.BatchId" class="caei-row-clickable @(isExpanded ? "caei-table-batch-row-expanded" : "")">
                                    <td style="padding: 0.75rem 1rem; vertical-align: middle;">
                                        <a href="@expandHref" class="btn btn-sm p-1 caei-btn-icon-only" aria-label="@(isExpanded ? "Collapse" : "Expand") batch details">
                                            @if (isExpanded)
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" aria-hidden="true"><polyline points="18 15 12 9 6 15"/></svg>
                                            }
                                            else
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#6b7280" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                                            }
                                        </a>
                                    </td>
                                    <td style="padding: 0.75rem 1rem; font-weight: 500; color: #111827;"><a href="@expandHref" class="caei-row-link" aria-label="View batch @(batch.BatchId.ToString().Substring(0, 8)) details">@batch.BatchId.ToString().Substring(0, 8)...</a></td>
                                    <td style="padding: 0.75rem 1rem; color: #374151;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@batch.SentAt?.ToString("yyyy-MM-dd")</a></td>
                                    <td style="padding: 0.75rem 1rem; color: #374151;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@batch.JournalName</a></td>
                                    <td style="padding: 0.75rem 1rem; color: #374151;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@(batch.SentAt?.ToString("yyyy-MM-dd") ?? "-")</a></td>
                                    <td style="padding: 0.75rem 1rem; color: #374151;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@(batch.Period ?? "-")</a></td>
                                    <td style="padding: 0.75rem 1rem; color: #374151; text-align: right;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@batch.BatchTotal?.ToString("C")</a></td>
                                    <td style="padding: 0.75rem 1rem; color: #374151;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@batch.ItemCount</a></td>
                                    <td style="padding: 0.75rem 1rem;">
                                        <a href="@expandHref" class="caei-row-link d-flex align-items-center gap-2" aria-label="View batch details, status @batch.Status">
                                            @if (statusLower is "success" or "completed" or "validated")
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@statusIconColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                                            }
                                            else if (statusLower is "rejected" or "error" or "failed")
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@statusIconColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                            }
                                            else if (statusLower is "pending" or "sent" or "processing")
                                            {
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="@statusIconColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                                            }
                                            <span class="px-2 py-1 caei-badge-inline @statusBadgeClass">@batch.Status</span>
                                        </a>
                                    </td>
                                    <td style="padding: 0.75rem 1rem; font-family: monospace; font-size: 0.8rem; color: #374151;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@(batch.RequestId.HasValue ? batch.RequestId.Value.ToString() : "-")</a></td>
                                    <td style="padding: 0.75rem 1rem; font-size: 0.8rem; color: #374151;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@batch.SentAt?.ToString("yyyy-MM-dd HH:mm:ss")</a></td>
                                    <td style="padding: 0.75rem 1rem; font-size: 0.8rem; color: #374151;"><a href="@expandHref" class="caei-row-link" aria-label="View batch details">@(batch.SentBy ?? "-")</a></td>
                                </tr>

                                @* ===== EXPANDED ROW ===== *@
                                @if (isExpanded && Model.ExpandedBatchDetail != null)
                                {
                                    <tr>
                                        <td colspan="12" style="padding: 0; background-color: #f9fafb;">
                                            <div style="padding: 1.5rem;">
                                                @* Error Alert (if any) *@
                                                @if (!string.IsNullOrEmpty(Model.ExpandedBatchDetail.ErrorDetail))
                                                {
                                                    <div class="d-flex align-items-start gap-2 mb-4" style="background-color: #fef2f2; border: 1px solid #fecaca; border-radius: 0.5rem; padding: 1rem;">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" class="flex-shrink-0" style="margin-top: 2px;"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                                        <div style="color: #991b1b;">
                                                            <strong>Error:</strong> @Model.ExpandedBatchDetail.ErrorDetail
                                                        </div>
                                                    </div>
                                                }

                                                @* Response Message *@
                                                <div class="mb-4">
                                                    <h6 class="fw-semibold mb-2" style="color: #111827;">Response Message</h6>
                                                    <div style="background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 0.375rem; padding: 0.75rem; color: #374151; font-size: 0.875rem;">
                                                        @(Model.ExpandedBatchDetail.AeResponseText ?? "-")
                                                    </div>
                                                </div>

                                                @* Item-Level Errors *@
                                                @if (Model.ExpandedBatchDetail.ItemErrors.Any())
                                                {
                                                    <div class="mb-4">
                                                        <h6 class="fw-semibold mb-2" style="color: #111827;">Item-Level Errors</h6>
                                                        <div style="background-color: #ffffff; border: 1px solid #e5e7eb; border-radius: 0.375rem; overflow: hidden;">
                                                            <table class="table table-sm mb-0" style="font-size: 0.875rem;">
                                                                <thead style="background-color: #f9fafb;">
                                                                    <tr>
                                                                        <th scope="col" style="padding: 0.75rem 1rem; color: #374151; font-weight: 500;">Item ID</th>
                                                                        <th scope="col" style="padding: 0.75rem 1rem; color: #374151; font-weight: 500;">Error Reason</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody>
                                                                    @foreach (var err in Model.ExpandedBatchDetail.ItemErrors)
                                                                    {
                                                                        <tr>
                                                                            <td style="padding: 0.75rem 1rem; font-family: monospace; font-size: 0.8rem; color: #374151;">@err.Description</td>
                                                                            <td style="padding: 0.75rem 1rem; font-size: 0.8rem; color: #dc2626;">@err.ErrorMessage</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                }

                                                @* Actions *@
                                                <div class="d-flex flex-wrap gap-2">
                                                    <a asp-page-handler="DownloadPayload" asp-route-batchId="@batch.BatchId"
                                                       class="btn btn-outline-secondary"
                                                       style="border-radius: 0.375rem;">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                                        Download Payload
                                                    </a>
                                                    @{
                                                        var previewHref =
                                                            "/Integrations/" + integration + "/History/SentHistory"
                                                            + "?StartDate=" + Model.StartDate?.ToString("yyyy-MM-dd")
                                                            + "&EndDate=" + Model.EndDate?.ToString("yyyy-MM-dd")
                                                            + "&StatusFilter=" + (Model.StatusFilter ?? "")
                                                            + "&JournalFilter=" + (Model.JournalFilter ?? "")
                                                            + "&BatchIdFilter=" + (Model.BatchIdFilter?.ToString() ?? "")
                                                            + "&RequestIdFilter=" + (Model.RequestIdFilter?.ToString() ?? "")
                                                            + "&ExpandedBatchId=" + batch.BatchId.ToString()
                                                            + "&PreviewBatchId=" + batch.BatchId.ToString()
                                                            + "#items-preview";
                                                    }
                                                    <a href="@previewHref"
                                                       class="btn btn-outline-primary"
                                                       style="border-radius: 0.375rem;">
                                                        Preview Items
                                                    </a>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5" style="color: #6b7280;">
                    No records found for selected filters.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sent-history.js"></script>
}
