@page "/Integrations/{integration}/Hiwu/Files/Detail"
@model CAHFS_Recharges.Pages.Integrations.Hiwu.DetailModel
@using CAHFS_Recharges.Hiwu
@using CAHFS_Recharges.Services
@{
    ViewData["Title"] = "HIWU manifest file";
    var pathBase = HttpContext.Request.PathBase;
    var file = Model.Manifest;
    var listReturn = IntegrationLinkHelper.HiwuReturnPath(Request.Query["back"], "/Integrations/EQUINE/Hiwu/Files");
    var backLabel = listReturn.StartsWith("/Integrations/EQUINE/Hiwu/Attempts", StringComparison.OrdinalIgnoreCase)
        ? "Back to attempts"
        : listReturn.StartsWith("/Integrations/EQUINE/Hiwu/Create", StringComparison.OrdinalIgnoreCase)
            ? "Back to create"
            : "Back to files";
}

<div class="d-flex flex-wrap align-items-start justify-content-between gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">HIWU manifest file</h1>
        <p class="text-muted mb-0">EQUINE. The page shows the fields. It does not show the raw XML.</p>
    </div>
    <a class="caei-btn-outline caei-btn-theme" href="@(pathBase)@listReturn" aria-label="@backLabel">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
        @backLabel
    </a>
</div>

@if (file == null)
{
    <div class="alert alert-warning" role="alert">This file was not found.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h2 class="h5 mb-3">@file.RemoteFileName</h2>
            <p class="mb-1">Downloaded @DetailModel.ToPacific(file.ReceivedUtc).ToString("yyyy-MM-dd HH:mm") Pacific</p>
            <p class="mb-3 d-inline-flex align-items-center gap-1">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                Status: @HiwuParseStatus.Label(file.ParseStatus)
            </p>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-outline-secondary" href="@(pathBase)/Integrations/EQUINE/Hiwu/Files/Detail?id=@file.FileId&handler=DownloadXml">Download raw XML</a>
                @if (Model.CanDownloadCsv)
                {
                    <a class="btn btn-primary" href="@(pathBase)/Integrations/EQUINE/Hiwu/Files/Detail?id=@file.FileId&handler=DownloadCsv">Download HIWU CSV</a>
                }
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body border-bottom py-3 d-flex flex-wrap align-items-start justify-content-between gap-2">
            <div>
            <h2 class="h5 mb-2">TraceFirst</h2>
            @if (!string.IsNullOrEmpty(Model.TraceFirstMessage))
            {
                <p role="status">@Model.TraceFirstMessage</p>
            }
            @if (file.IsAmendment)
            {
                <p class="mb-0">Amendments are not sent to TraceFirst.</p>
            }
            else if (file.ParseStatus != HiwuParseStatus.Received)
            {
                <p class="mb-0">Only a received file can be created in TraceFirst.</p>
            }
            else
            {
                <p class="mb-0"><a class="btn btn-primary" href="@(pathBase)@IntegrationLinkHelper.AppendHiwuReturn($"/Integrations/EQUINE/Hiwu/Create/Review?id={file.FileId:D}", $"/Integrations/EQUINE/Hiwu/Files/Detail?id={file.FileId:D}" + (string.IsNullOrEmpty(Request.Query["back"]) ? "" : "&back=" + Uri.EscapeDataString(Request.Query["back"].ToString())))">Open Create in TraceFirst</a></p>
            }
            </div>
            @if (Model.TraceFirstSamples.Count > 0)
            {
                <partial name="_TableDensityToggle" />
            }
        </div>
        @if (Model.TraceFirstSamples.Count > 0)
        {
            <div class="table-responsive caei-scroll-y-400">
                <table class="table table-borderless caei-data-table mb-0">
                    <thead class="sticky-top bg-white">
                        <tr>
                            <th scope="col">Sample</th>
                            <th scope="col">Status</th>
                            <th scope="col">Accession</th>
                            <th scope="col">Animal</th>
                            <th scope="col">Specimen</th>
                            <th scope="col">Result</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.TraceFirstSamples)
                        {
                            <tr>
                                <td><span class="caei-data-key">@row.SampleKey</span></td>
                                <td><span class="badge @HiwuCoflSampleStatus.BadgeClass(row.Status)">@row.Status</span></td>
                                <td><span class="caei-data-key">@(row.AccessionNumber ?? row.AccessionId?.ToString() ?? "—")</span></td>
                                <td><span class="caei-data-key">@HiwuCoflSampleRow.Display(row.AnimalLabel, row.AnimalId)</span></td>
                                <td><span class="caei-data-key">@HiwuCoflSampleRow.Display(row.SpecimenLabel, row.SpecimenId)</span></td>
                                <td>@(string.IsNullOrEmpty(row.ErrorMessage) ? "—" : row.ErrorMessage)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-body d-flex flex-wrap gap-2">
                <a class="caei-btn-outline caei-btn-theme" href="@(pathBase)/Integrations/EQUINE/Hiwu/Attempts">TraceFirst attempts</a>
            </div>
        }
    </div>

    @if (file.ParseStatus == HiwuParseStatus.ParseError)
    {
        <div class="alert alert-warning" role="alert">
            <h2 class="h5">This file was kept, and it did not pass the v1.8 schema.</h2>
            <p class="mb-0">@(string.IsNullOrWhiteSpace(file.ParseError) ? "No validation message was stored." : file.ParseError)</p>
        </div>
    }
    else if (Model.Document == null)
    {
        <div class="alert alert-warning" role="alert">The stored file could not be read as a testMission document.</div>
    }
    else if (file.IsAmendment && Model.OriginalMissing)
    {
        <div class="alert alert-warning" role="alert">
            <h2 class="h5">The original file has not been received.</h2>
            <p class="mb-0">The amendment is stored. There is no original to compare.</p>
        </div>
        @await Html.PartialAsync("_MissionAndSamples", Model)
    }
    else if (file.IsAmendment && Model.OriginalDocument != null)
    {
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                <h2 class="h5 mb-0">Mission changes</h2>
                <partial name="_TableDensityToggle" />
                </div>
                <div class="table-responsive caei-scroll-y-400">
                    <table class="table table-borderless caei-data-table mb-0">
                        <thead class="sticky-top bg-white">
                            <tr>
                                <th scope="col">Field</th>
                                <th scope="col">Original</th>
                                <th scope="col">Amendment</th>
                                <th scope="col">Result</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.MissionCompare)
                            {
                                <tr>
                                    <td>@row.Field</td>
                                    <td>@(string.IsNullOrEmpty(row.Original) ? "—" : row.Original)</td>
                                    <td>@(string.IsNullOrEmpty(row.Amendment) ? "—" : row.Amendment)</td>
                                    <td>@(row.Changed ? "Changed" : "")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <h2 class="h5 mb-0">Samples in this amendment</h2>
        <partial name="_TableDensityToggle" />
        </div>
        @foreach (var sample in Model.SampleCompare)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h3 class="h6">Sample @sample.SampleId</h3>
                    @if (sample.MissingOnOriginal)
                    {
                        <p>This sample is not on the original file.</p>
                    }
                    <div class="table-responsive caei-scroll-y-400">
                        <table class="table table-borderless caei-data-table mb-0">
                            <thead class="sticky-top bg-white">
                                <tr>
                                    <th scope="col">Field</th>
                                    <th scope="col">Original</th>
                                    <th scope="col">Amendment</th>
                                    <th scope="col">Result</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in sample.Fields)
                                {
                                    <tr>
                                        <td>@row.Field</td>
                                        <td>@(string.IsNullOrEmpty(row.Original) ? "—" : row.Original)</td>
                                        <td>@(string.IsNullOrEmpty(row.Amendment) ? "—" : row.Amendment)</td>
                                        <td>@(row.Changed ? "Changed" : "")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        @await Html.PartialAsync("_MissionAndSamples", Model)
    }
}
