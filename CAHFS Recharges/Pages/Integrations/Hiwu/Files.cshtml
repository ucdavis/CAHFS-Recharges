@page "/Integrations/{integration}/Hiwu/Files"
@model CAHFS_Recharges.Pages.Integrations.Hiwu.FilesModel
@using CAHFS_Recharges.Hiwu
@using CAHFS_Recharges.Services
@{
    ViewData["Title"] = "HIWU manifest files";
    var pathBase = HttpContext.Request.PathBase;
    var qEncoded = Uri.EscapeDataString(Model.Q ?? "");
    var exportUrl = $"{pathBase}/Integrations/EQUINE/Hiwu/Files?handler=Export&fromDate={Model.FromDate:yyyy-MM-dd}&toDate={Model.ToDate:yyyy-MM-dd}&status={Uri.EscapeDataString(Model.Status ?? "")}&q={qEncoded}";
    var listReturn = "/Integrations/EQUINE/Hiwu/Files" + Request.QueryString.Value;
    var selectedStatus = Model.Status ?? "";
    var showReviewed = string.Equals(selectedStatus, HiwuParseStatus.Amended, StringComparison.OrdinalIgnoreCase);
    var colCount = showReviewed ? 6 : 5;

    string CardUrl(string? status)
    {
        var parts = new List<string>();
        if (!Model.HasSearch)
        {
            if (Model.FromDate.HasValue)
                parts.Add($"FromDate={Model.FromDate:yyyy-MM-dd}");
            if (Model.ToDate.HasValue)
                parts.Add($"ToDate={Model.ToDate:yyyy-MM-dd}");
        }
        else if (!string.IsNullOrWhiteSpace(Model.Q))
        {
            parts.Add($"q={Uri.EscapeDataString(Model.Q)}");
        }
        if (!string.IsNullOrWhiteSpace(status))
            parts.Add($"Status={Uri.EscapeDataString(status)}");
        var query = parts.Count == 0 ? "" : "?" + string.Join("&", parts);
        return $"{pathBase}/Integrations/EQUINE/Hiwu/Files{query}";
    }
}

@* Title + Search (top row). GET search uses site.js: .is-loading, #global-progress-bar, .caei-skeleton-row *@
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">HIWU manifest files</h1>
        <p class="text-muted mb-0">EQUINE files downloaded from HIWU. Dates are Pacific time.</p>
    </div>
    <div class="caei-global-search" style="min-width: min(100%, 22rem);">
        <form method="get"
              class="d-flex flex-wrap align-items-end gap-2"
              aria-label="Find sample or accession"
              data-caei-live="search">
            <div class="flex-grow-1 caei-field">
                <label asp-for="Q" class="form-label mb-1">Global Search</label>
                <input asp-for="Q"
                       name="q"
                       class="form-control"
                       type="search"
                       placeholder="Sample ID or Accession"
                       autocomplete="off"
                       aria-describedby="@(Model.HasSearch ? "caei-search-status" : null)" />
            </div>
            <button type="submit" class="btn btn-primary">Find</button>
        </form>
        @if (Model.HasSearch)
        {
            <div id="caei-search-status" class="mt-2 d-flex flex-wrap align-items-center gap-2" role="status">
                <span class="small text-muted">
                    <span class="caei-data-key">@Model.Files.Count</span> file(s) match
                    <span class="caei-data-key">@Model.Q</span>
                </span>
                @* Full navigation (no data-caei-filter-nav): AJAX only swaps data-caei-region and would leave this status text stale. *@
                <a href="@(pathBase)/Integrations/EQUINE/Hiwu/Files"
                   class="btn btn-sm caei-btn-outline caei-btn-theme">
                    Clear
                </a>
            </div>
        }
    </div>
</div>

<div class="staging-stats-grid staging-stats-grid-5 mb-4" data-caei-region="summary">
    <a href="@CardUrl(null)" data-caei-filter-nav
       class="staging-stat-card staging-stat-clickable"
       aria-current="@(string.IsNullOrEmpty(selectedStatus) ? "true" : "false")"
       aria-label="Total files (@Model.TotalCount). Show every file in this date range.">
        <span class="staging-stat-value">@Model.TotalCount</span>
        <div class="staging-stat-label">Total files</div>
        <div class="staging-stat-action text-muted small">@(string.IsNullOrEmpty(selectedStatus) ? "Showing" : "Show all")</div>
    </a>
    <a href="@CardUrl(HiwuParseStatus.Received)" data-caei-filter-nav
       class="staging-stat-card staging-stat-clickable @(Model.ReceivedCount > 0 ? "has-success" : "")"
       aria-current="@(selectedStatus == HiwuParseStatus.Received ? "true" : "false")"
       aria-label="Received (@Model.ReceivedCount). Show received files.">
        <span class="staging-stat-value">@Model.ReceivedCount</span>
        <div class="staging-stat-label">Received</div>
        <div class="staging-stat-action text-muted small">@(selectedStatus == HiwuParseStatus.Received ? "Showing" : "Show these")</div>
    </a>
    <a href="@CardUrl(HiwuParseStatus.Amended)" data-caei-filter-nav
       class="staging-stat-card staging-stat-clickable @(Model.AmendedCount > 0 ? "has-warning" : "")"
       aria-current="@(selectedStatus == HiwuParseStatus.Amended ? "true" : "false")"
       aria-label="Amended (@Model.AmendedCount). Show amended files.">
        <span class="staging-stat-value">@Model.AmendedCount</span>
        <div class="staging-stat-label">Amended</div>
        <div class="staging-stat-action text-muted small">@(selectedStatus == HiwuParseStatus.Amended ? "Showing" : "Show these")</div>
    </a>
    <a href="@CardUrl(HiwuCoflSampleStatus.Imported)" data-caei-filter-nav
       class="staging-stat-card staging-stat-clickable @(Model.ImportedCount > 0 ? "has-success" : "")"
       aria-current="@(selectedStatus == HiwuCoflSampleStatus.Imported ? "true" : "false")"
       aria-label="Imported (@Model.ImportedCount). Show files imported into TraceFirst.">
        <span class="staging-stat-value">@Model.ImportedCount</span>
        <div class="staging-stat-label">Imported</div>
        <div class="staging-stat-action text-muted small">@(selectedStatus == HiwuCoflSampleStatus.Imported ? "Showing" : "Show these")</div>
    </a>
    <a href="@CardUrl(HiwuParseStatus.ParseError)" data-caei-filter-nav
       class="staging-stat-card staging-stat-clickable @(Model.ParseErrorCount > 0 ? "has-warning" : "")"
       aria-current="@(selectedStatus == HiwuParseStatus.ParseError ? "true" : "false")"
       aria-label="Parse error (@Model.ParseErrorCount). Show files with a parse error.">
        <span class="staging-stat-value">@Model.ParseErrorCount</span>
        <div class="staging-stat-label">Parse error</div>
        <div class="staging-stat-action text-muted small">@(selectedStatus == HiwuParseStatus.ParseError ? "Showing" : "Show these")</div>
    </a>
</div>

@if (!Model.HasSearch)
{
    <form method="get" class="caei-control-panel mb-4" aria-label="Manifest filters" data-caei-filter>
        <h2 class="h6 mb-3">Filters</h2>
        <div class="row g-3 align-items-end">
            <div class="col-md-3 col-sm-6">
                <label asp-for="FromDate" class="form-label">From date <span class="text-muted fw-normal">(optional)</span></label>
                <input asp-for="FromDate" class="form-control" type="date" />
            </div>
            <div class="col-md-3 col-sm-6">
                <label asp-for="ToDate" class="form-label">To date <span class="text-muted fw-normal">(optional)</span></label>
                <input asp-for="ToDate" class="form-control" type="date" />
            </div>
            <input asp-for="Status" type="hidden" />
            <div class="col-md-6 d-flex align-items-end gap-2 flex-wrap">
                <button type="submit" class="btn btn-primary">Apply filters</button>
                <a href="@(pathBase)/Integrations/EQUINE/Hiwu/Files" class="btn btn-outline-secondary" data-caei-filter-nav>Reset</a>
                <a href="@exportUrl" class="btn btn-outline-secondary" data-caei-live="export">Download Excel</a>
            </div>
        </div>
    </form>
}
else
{
    <div class="mb-4 d-flex flex-wrap gap-2">
        <a href="@exportUrl" class="btn btn-outline-secondary" data-caei-live="export">Download Excel</a>
    </div>
}

<div class="card mb-3" data-caei-region="results">
    <div class="card-body border-bottom py-3 d-flex flex-wrap align-items-start justify-content-between gap-2">
        <div>
        <h2 class="h5 mb-1">Manifest files</h2>
        <p class="text-muted small mb-0">Showing @Model.Files.Count file(s), up to 1,000. Download Excel uses these same filters.</p>
        </div>
        <partial name="_TableDensityToggle" />
    </div>
    @* Always render tbody so GET search can swap in .caei-skeleton-row via site.js *@
    <div class="table-responsive caei-scroll-y-400" style="min-width: 0; max-width: 100%;">
        <table class="table table-borderless caei-data-table mb-0">
            <thead class="sticky-top bg-white">
                <tr>
                    <th scope="col">File name</th>
                    <th scope="col">Samples</th>
                    <th scope="col">Date downloaded</th>
                    <th scope="col">Status</th>
                    <th scope="col">TraceFirst</th>
                    @if (showReviewed)
                    {
                        <th scope="col">Reviewed</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Files.Count == 0)
                {
                    <tr>
                        <td colspan="@colCount" class="p-0 border-0">
                            <partial name="_EmptyState" model='new CAHFS_Recharges.Models.CaeiEmptyState {
                                Title = Model.HasSearch ? "No matching files" : "No manifest files",
                                Message = Model.HasSearch
                                    ? "No manifest files match that sample ID or accession."
                                    : "No manifest files found for the selected filters.",
                                ActionHref = $"{pathBase}/Integrations/EQUINE/Hiwu/Files",
                                ActionText = Model.HasSearch ? "Clear search" : "Clear filters",
                                UseFilterNav = !Model.HasSearch
                            }' />
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var file in Model.Files)
                    {
                        var hiwuStatusClass = file.ParseStatus switch
                        {
                            HiwuParseStatus.ParseError => "badge-soft-danger",
                            HiwuParseStatus.Amended => "badge-soft-warning",
                            _ => "badge-soft-success"
                        };
                        var traceFirstStatus = Model.TraceFirstStatus.TryGetValue(file.FileId, out var traceFirst) ? traceFirst : "Not started";
                        <tr>
                            <td>
                                <a class="caei-data-key" href="@(pathBase)@IntegrationLinkHelper.AppendHiwuReturn(IntegrationLinkHelper.GetHiwuFileDetailPage(file.FileId), listReturn)">@file.RemoteFileName</a>
                            </td>
                            <td>
                                <span>@file.SampleCount</span>
                                @if (file.HasBSample == true)
                                {
                                    <span class="caei-badge-b-sample caei-badge-b-sample-inline" title="B-Sample test requested">⚠ B-Sample</span>
                                }
                            </td>
                            <td>@FilesModel.ToPacific(file.ReceivedUtc).ToString("yyyy-MM-dd HH:mm")</td>
                            <td>
                                <span class="badge @hiwuStatusClass d-inline-flex align-items-center gap-1">
                                    @if (file.ParseStatus == HiwuParseStatus.ParseError)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M12 3l9 16H3L12 3z"/></svg>
                                    }
                                    else if (file.ParseStatus == HiwuParseStatus.Amended)
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5M18.5 2.5a2.1 2.1 0 013 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                                    }
                                    @HiwuParseStatus.Label(file.ParseStatus)
                                </span>
                            </td>
                            <td><span class="badge @HiwuCoflSampleStatus.BadgeClass(traceFirstStatus)">@traceFirstStatus</span></td>
                            @if (showReviewed)
                            {
                                <td>
                                    @if (Model.ReviewProgress.TryGetValue(file.FileId, out var reviewed))
                                    {
                                        var reviewClass = reviewed.Complete ? "badge-soft-success" : "badge-soft-warning";
                                        <span class="badge @reviewClass">@reviewed.Label</span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
