@model IReadOnlyList<CAHFS_Recharges.Hiwu.HiwuCoflMapLine>
<div class="table-responsive">
    <table class="table table-borderless caei-data-table mb-0">
        <thead class="sticky-top bg-white">
            <tr>
                <th scope="col">HIWU field</th>
                <th scope="col">TraceFirst field</th>
                <th scope="col">Value to send</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var line in Model)
            {
                <tr>
                    <td class="data-grid-label">@line.HiwuField</td>
                    <td class="data-grid-label">@line.TraceFirstField</td>
                    <td class="data-grid-value">@line.Value</td>
                </tr>
            }
        </tbody>
    </table>
</div>
