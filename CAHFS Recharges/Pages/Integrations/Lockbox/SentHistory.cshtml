@page "/Integrations/{integration}/Lockbox/SentHistory"
@model CAHFS_Recharges.Pages.Integrations.Lockbox.SentHistoryModel
@{
    ViewData["Title"] = "Sent History";
    var integration = ViewData["Integration"] as string ?? "CAHFS";
}

<div class="mb-4">
    <h1 class="h3 mb-1">Sent History</h1>
    <p class="text-muted mb-0">Lockbox payments posted to Great Plains (@integration).</p>
</div>

<div class="alert alert-info" role="status">
    Sent history is coming soon. This will list completed GP payment posts from lockbox staging.
</div>
