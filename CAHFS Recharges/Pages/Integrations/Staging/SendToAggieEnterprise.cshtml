@page "/Integrations/{integration}/Staging/SendToAggieEnterprise"
@model CAHFS_Recharges.Pages.Integrations.Staging.SendToAggieEnterpriseModel
@using CAHFS_Recharges.Services
@{
    ViewData["Title"] = "Send to AE";
    var isOperator = ViewData["IsOperator"] as bool? ?? false;
    var integration = ViewData["Integration"] as string ?? "CAHFS";
    var readyCount = Model.Batches?.Count(b => b.AERequestStatus == "Ready") ?? 0;
    var invalidBatchCount = Model.InvalidBatchCount;
}

<div class="p-4">
    @* ===== PAGE HEADER ===== *@
    <div class="mb-4">
        <h1 class="fw-bold mb-1 caei-heading-page">Send to AE</h1>
        <p class="mb-0 text-muted">
            Manual build, preview, and send for a selected batch. Batch must be <strong>Ready</strong> and all items <strong>Valid</strong>.
            <span class="ms-2 text-muted small">Last refreshed: @Model.LastRefreshedAt.ToString("HH:mm:ss")</span>
        </p>
    </div>

    @* Messages *@
    @if (!isOperator)
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <strong>View Only:</strong> You have Viewer access. Send actions require Operator permissions.
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SuccessMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @Model.SuccessMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @Model.ErrorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.InfoMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @Model.InfoMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* ===== SUMMARY CARDS (match Staging / Sent History) ===== *@
    <div class="staging-stats-grid mb-4">
        <div class="staging-stat-card @(readyCount > 0 ? "has-success" : "")">
            <div class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(readyCount > 0 ? "text-success" : "text-muted")"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                <span class="staging-stat-value @(readyCount > 0 ? "text-success" : "")">@readyCount</span>
            </div>
            <div class="staging-stat-label">Ready to Send</div>
        </div>
        <a href="/Integrations/@integration/Staging/CoaValidations" class="staging-stat-card staging-stat-clickable @(invalidBatchCount > 0 ? "caei-staging-warning" : "")">
            <div class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(invalidBatchCount > 0 ? "text-warning" : "text-muted")"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span class="staging-stat-value @(invalidBatchCount > 0 ? "text-warning" : "")">@invalidBatchCount</span>
            </div>
            <div class="staging-stat-label">Invalid Batches</div>
            <div class="staging-stat-action">View Invalid Batches →</div>
        </a>
        <a href="/Integrations/@integration/History/SentHistory" class="staging-stat-card staging-stat-clickable @(Model.SuccessfullySentCount > 0 ? "has-success" : "")">
            <div class="d-flex align-items-center gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="@(Model.SuccessfullySentCount > 0 ? "text-success" : "text-muted")"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span class="staging-stat-value @(Model.SuccessfullySentCount > 0 ? "text-success" : "")">@Model.SuccessfullySentCount</span>
            </div>
            <div class="staging-stat-label">Sent History</div>
            <div class="staging-stat-action">View History →</div>
        </a>
    </div>

    @* ===== FILTERS CARD ===== *@
    <div class="card mb-4 border caei-card-lg">
        <div class="card-header bg-white border-bottom caei-card-header-tight">
            <h5 class="mb-0 fw-semibold text-gray-900">Filters</h5>
        </div>
        <div class="card-body caei-card-body-tight">
            <form method="get">
                <input type="hidden" name="integration" value="@integration" />
                <div class="row g-4 align-items-end">
                    <div class="col">
                        <label asp-for="FromDate" class="form-label small mb-2 caei-label">From Date</label>
                        <input asp-for="FromDate" class="form-control caei-control-radius" type="date" />
                    </div>
                    <div class="col">
                        <label asp-for="ToDate" class="form-label small mb-2 caei-label">To Date</label>
                        <input asp-for="ToDate" class="form-control caei-control-radius" type="date" />
                    </div>
                    <div class="col">
                        <label asp-for="JournalName" class="form-label small mb-2 caei-label">Journal Name</label>
                        <input asp-for="JournalName" class="form-control caei-control-radius" placeholder="Search..." />
                    </div>
                    <div class="col">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn caei-btn-filter">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                Apply Filters
                            </button>
                            <a href="/Integrations/@integration/Staging/SendToAggieEnterprise" class="btn btn-outline-secondary caei-control-radius">Reset</a>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    @* ===== EMPTY STATE ===== *@
    @if (!Model.Batches.Any())
    {
        <div class="card border caei-card-warning-border">
            <div class="card-body text-center py-5">
                <div class="mb-3">
                    <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#9ca3af" stroke-width="2" class="text-muted"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                </div>
                <h5 class="mb-1 text-gray-900">No Ready Batches Found</h5>
                <p class="text-muted mb-4">No batches match your current filters. Try adjusting the date range or journal name.</p>
                <a href="/Integrations/@integration/Staging/SendToAggieEnterprise" class="btn btn-outline-primary caei-control-radius">Clear Filters</a>
            </div>
        </div>
    }
    else
    {
        @* ===== SELECT BATCH CARD ===== *@
        <div class="card mb-4 border caei-card-lg">
            <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between caei-card-header-tight">
                <h5 class="mb-0 fw-semibold text-gray-900">Select Batch</h5>
                <span class="badge bg-secondary">@Model.Batches.Count batches</span>
            </div>
            <div class="card-body caei-card-body-tight">
                <form method="get" id="batchSelectForm">
                    <input type="hidden" name="integration" value="@integration" />
                    <input type="hidden" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="JournalName" value="@Model.JournalName" />
                    <label for="batchSelect" class="visually-hidden">Select a batch</label>
                    <select class="form-select caei-control-radius w-100" name="SelectedBatchId" id="batchSelect">
                        <option value="" selected="@(!Model.SelectedBatchId.HasValue)">— Select a batch —</option>
                        @foreach (var b in Model.Batches)
                        {
                            var statusIcon = b.AERequestStatus switch
                            {
                                "Ready" => "🟢",
                                "Needs Review" => "🟡",
                                "Sent" or "Complete" => "🔵",
                                "Error" => "🔴",
                                _ => "⚪"
                            };
                            <option value="@b.BatchID" selected="@(Model.SelectedBatchId == b.BatchID)">
                                @statusIcon @b.AEJournalName — @(b.BatchTotal?.ToString("C") ?? "$0.00") — @(b.AERequestStatus ?? "Unknown")
                            </option>
                        }
                    </select>
                </form>
            </div>
        </div>

        @* ===== SELECTED BATCH: SUMMARY + GATE + ACTIONS ===== *@
        @if (Model.SelectedBatch != null)
        {
            <div class="row g-4" id="batch">
                @* Left: Batch Summary *@
                <div class="col-lg-7">
                    <div class="card border caei-card-lg">
                        <div class="card-header bg-white border-bottom caei-card-header-tight">
                            <h5 class="mb-0 fw-semibold text-gray-900">Batch Summary</h5>
                        </div>
                        <div class="card-body caei-card-body-tight">
                            <div class="row">
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td class="text-muted caei-w-140">Batch ID</td>
                                            <td><code class="small">@Model.SelectedBatch.BatchID</code></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Journal Name</td>
                                            <td><strong>@Model.SelectedBatch.AEJournalName</strong></td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Journal Reference</td>
                                            <td>@(Model.SelectedBatch.AEJournalReference ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Batch Total</td>
                                            <td><strong>@(Model.SelectedBatch.BatchTotal?.ToString("C") ?? "—")</strong></td>
                                        </tr>
                                    </table>
                                </div>
                                <div class="col-md-6">
                                    <table class="table table-sm table-borderless mb-0">
                                        <tr>
                                            <td class="text-muted caei-w-140">Accounting Date</td>
                                            <td>@(Model.AccountingDateText ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Accounting Period</td>
                                            <td>@(Model.AccountingPeriodText ?? "—")</td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">AE Status</td>
                                            <td>
                                                @{
                                                    var statusBadgeClass = Model.SelectedBatch.AERequestStatus switch
                                                    {
                                                        "Ready" => "caei-badge-inline-success",
                                                        "Needs Review" => "caei-badge-inline-pending",
                                                        "Sent" or "Complete" => "caei-badge-inline-sent",
                                                        "Error" => "caei-badge-inline-error",
                                                        _ => "caei-badge-inline-default"
                                                    };
                                                }
                                                <span class="px-2 py-1 caei-badge-inline @statusBadgeClass">@(Model.SelectedBatch.AERequestStatus ?? "Unknown")</span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <td class="text-muted">Request ID</td>
                                            <td>
                                                @if (Model.SelectedBatch.AEConsumerRequestID.HasValue)
                                                {
                                                    <code class="small">@Model.SelectedBatch.AEConsumerRequestID</code>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                            @if (!string.IsNullOrEmpty(Model.SelectedBatch.ErrorDetail))
                            {
                                <div class="alert alert-danger mt-3 mb-0 py-3 caei-control-radius">
                                    <strong>Error:</strong>
                                    <pre class="mb-0 small caei-pre-wrap">@Model.SelectedBatch.ErrorDetail</pre>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                @* Right: Gate + Actions *@
                <div class="col-lg-5">
                    <div class="card mb-3 border caei-card-lg @(Model.GateCanSend ? "" : "caei-card-warning-border")">
                        <div class="card-header border-bottom caei-card-header-tight caei-card-header-rounded-top @(Model.GateCanSend ? "bg-success text-white" : "bg-warning text-dark")">
                            <strong>@(Model.GateCanSend ? "✓ OK to Send" : "⚠ Blocked")</strong>
                        </div>
                        <div class="card-body caei-card-body-tight">
                            <p class="mb-3 caei-label">@Model.GateMessage</p>
                            @if (Model.GateSummary != null)
                            {
                                <div class="row text-center g-2 mb-3">
                                    <div class="col-4">
                                        <div class="fw-bold caei-stat-value-lg">@Model.GateSummary.TotalItems</div>
                                        <small class="text-muted">Total</small>
                                    </div>
                                    <div class="col-4">
                                        <div class="fw-bold caei-stat-value-lg @(Model.GateSummary.PendingCount > 0 ? "caei-text-amber" : "text-gray-900")">@Model.GateSummary.PendingCount</div>
                                        <small class="text-muted">Pending</small>
                                    </div>
                                    <div class="col-4">
                                        <div class="fw-bold caei-stat-value-lg @(Model.GateSummary.NotValidCount > 0 ? "text-danger" : "text-gray-900")">@Model.GateSummary.NotValidCount</div>
                                        <small class="text-muted">Invalid / not valid</small>
                                    </div>
                                </div>
                                @if (!Model.GateCanSend && (Model.GateSummary.InvalidCount > 0 || Model.GateSummary.NotValidCount > 0))
                                {
                                    <a href="/Integrations/@integration/Staging/CoaValidations?SelectedBatchId=@Model.SelectedBatchId" class="btn btn-outline-danger w-100 caei-control-radius">Fix Invalid COA →</a>
                                }
                            }
                        </div>
                    </div>

                    <div class="card border caei-card-lg">
                        <div class="card-header bg-white border-bottom caei-card-header-tight">
                            <h5 class="mb-0 fw-semibold text-gray-900">Actions</h5>
                        </div>
                        <div class="card-body caei-card-body-tight">
                            <div class="d-grid gap-2">
                                <form method="post" asp-page-handler="BuildPreview">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Integration" value="@integration" />
                                    <input type="hidden" name="SelectedBatchId" value="@Model.SelectedBatchId" />
                                    <input type="hidden" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                                    <input type="hidden" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                                    <input type="hidden" name="JournalName" value="@Model.JournalName" />
                                    <button type="submit" class="btn btn-outline-primary w-100 caei-control-radius" disabled="@(!isOperator)" title="@(!isOperator ? "Requires Operator permissions" : "Build a preview of the journal payload")">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                                        Build Preview
                                    </button>
                                </form>
                                <button type="button" class="btn btn-success w-100 text-white caei-control-radius caei-btn-no-border"
                                        data-bs-toggle="modal" data-bs-target="#confirmSendModal"
                                        disabled="@(!Model.GateCanSend || !isOperator)"
                                        title="@(!isOperator ? "Requires Operator permissions" : (!Model.GateCanSend ? "Batch not ready to send" : "Send this batch to Aggie Enterprise"))">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
                                    Send to AE
                                </button>
                                <form method="post" asp-page-handler="RefreshStatus">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Integration" value="@integration" />
                                    <input type="hidden" name="SelectedBatchId" value="@Model.SelectedBatchId" />
                                    <input type="hidden" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                                    <input type="hidden" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                                    <input type="hidden" name="JournalName" value="@Model.JournalName" />
                                    <button type="submit" class="btn btn-outline-secondary w-100 caei-control-radius" disabled="@(!isOperator)" title="@(!isOperator ? "Requires Operator permissions" : "Check the current status from AE")">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 21h5v-5"/></svg>
                                        Refresh Status
                                    </button>
                                </form>
                                <hr class="my-2" />
                                <a class="btn btn-outline-secondary w-100 caei-control-radius"
                                   asp-page-handler="DownloadPayload"
                                   asp-route-Integration="@integration"
                                   asp-route-SelectedBatchId="@Model.SelectedBatchId"
                                   asp-route-FromDate="@(Model.FromDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-ToDate="@(Model.ToDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-JournalName="@Model.JournalName">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="me-2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                                    Download Payload (JSON)
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* ===== BUILD PREVIEW CARD ===== *@
            @if (Model.Preview != null)
            {
                <div class="card border border-info mt-4 caei-card-lg">
                    <div class="card-header text-white border-0 caei-card-header-tight caei-modal-header-info">
                        <h5 class="mb-0 fw-semibold">Build Preview</h5>
                    </div>
                    <div class="card-body caei-card-body-tight">
                        <div class="row text-center g-3">
                            <div class="col-md-2">
                                <div class="fw-bold caei-stat-value-xl">@Model.Preview.ItemCount</div>
                                <small class="text-muted">Items</small>
                            </div>
                            <div class="col-md-2">
                                <div class="fw-bold caei-stat-value-xl">@Model.Preview.JournalLineCount</div>
                                <small class="text-muted">Journal Lines</small>
                            </div>
                            <div class="col-md-3">
                                <div class="fw-bold caei-stat-value-xl text-success">@Model.Preview.DebitTotal.ToString("C")</div>
                                <small class="text-muted">Debit Total</small>
                            </div>
                            <div class="col-md-3">
                                <div class="fw-bold caei-stat-value-xl text-danger">@Model.Preview.CreditTotal.ToString("C")</div>
                                <small class="text-muted">Credit Total</small>
                            </div>
                            <div class="col-md-2">
                                <div class="fw-bold caei-stat-value-xl @(Model.Preview.IsBalanced ? "text-success" : "text-danger")">@(Model.Preview.IsBalanced ? "✓ Yes" : "✗ No")</div>
                                <small class="text-muted">Balanced</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }

    @* ===== CONFIRM SEND MODAL ===== *@
    <div class="modal fade" id="confirmSendModal" tabindex="-1" aria-labelledby="confirmSendModalLabel" aria-modal="true" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content caei-modal-content-rounded">
                <div class="modal-header text-dark caei-modal-header-warning">
                    <h5 class="modal-title fw-semibold" id="confirmSendModalLabel">Confirm Send to AE</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body caei-modal-body-tight">
                    <p class="mb-3 caei-label">You are about to send this batch to Aggie Enterprise:</p>
                    @if (Model.SelectedBatch != null)
                    {
                        <ul class="mb-3 text-gray-900">
                            <li><strong>Journal:</strong> @Model.SelectedBatch.AEJournalName</li>
                            <li><strong>Total:</strong> @(Model.SelectedBatch.BatchTotal?.ToString("C") ?? "—")</li>
                            <li><strong>Items:</strong> @(Model.GateSummary?.TotalItems ?? 0)</li>
                        </ul>
                    }
                    <p class="text-danger mb-0 fw-semibold">This action cannot be undone.</p>
                </div>
                <div class="modal-footer border-top caei-modal-footer-tight">
                    <button type="button" class="btn btn-outline-secondary caei-control-radius" data-bs-dismiss="modal">Cancel</button>
                    <form method="post" asp-page-handler="SendToAe" class="d-inline" id="sendToAeForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="Integration" value="@integration" />
                        <input type="hidden" name="SelectedBatchId" value="@Model.SelectedBatchId" />
                        <input type="hidden" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />
                        <input type="hidden" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />
                        <input type="hidden" name="JournalName" value="@Model.JournalName" />
                        <button type="submit" class="btn caei-btn-success-solid">
                            Send to AE
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @* Full-screen overlay shown while sending batch to AE *@
    <div id="sendToAeOverlay" class="caei-send-overlay d-none" aria-hidden="true">
        <div class="caei-send-overlay-content">
            <div class="spinner-border text-light" role="status" aria-hidden="true"></div>
            <div class="mt-3 fw-semibold">Sending batch to Aggie Enterprise…</div>
            <div class="text-light small mt-1">Please do not close this window.</div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/send-to-ae-batch-select.js"></script>
}
