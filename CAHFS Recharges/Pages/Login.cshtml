@page
@model CAHFS_Recharges.Pages.LoginModel
@{
    ViewData["Title"] = "Sign in";
    ViewData["Integration"] = null;
    ViewData["IntegrationAuthorized"] = false;
}

<div class="caei-home">
    <h1 class="visually-hidden">Sign in to CAEI</h1>

    <div class="caei-home-welcome">
        <h2>Welcome to <span class="caei-data-key">CAEI</span></h2>
        <p class="text-muted mb-0">CAHFS Integration Hub</p>
    </div>

    @if (Model.SignedOut)
    {
        <div class="mb-4 text-center" role="status">
            <span class="status-indicator text-muted">
                <span class="status-indicator-dot info" aria-hidden="true"></span>
                You have been signed out of CAEI. The next sign-in will ask for your campus credentials again.
            </span>
        </div>
    }

    <section class="caei-home-section" aria-labelledby="login-auth">
        <h2 id="login-auth" class="h5 caei-data-key caei-home-section-title">Sign in</h2>
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <article class="card caei-workspace-card h-100">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="caei-workspace-mark" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2z"/>
                                </svg>
                            </div>
                            <span class="status-indicator text-muted small">
                                <span class="status-indicator-dot info" aria-hidden="true"></span>
                                UC Davis CAS
                            </span>
                        </div>
                        <h3 class="h5 caei-data-key">Campus login</h3>
                        <p class="text-muted small mb-3">
                            Use your UC Davis Kerberos account to access CAEI workspaces.
                        </p>
                        <a asp-page="/Login"
                           asp-page-handler="Cas"
                           asp-route-ReturnUrl="@Model.ReturnUrl"
                           asp-route-SignedOut="@(Model.SignedOut ? "true" : null)"
                           class="btn btn-primary w-100 caei-data-key mt-auto">
                            Login with CAS
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                                <path fill-rule="evenodd" d="M4 8a.5.5 0 0 1 .5-.5h5.793L8.146 5.354a.5.5 0 1 1 .708-.708l3 3a.5.5 0 0 1 0 .708l-3 3a.5.5 0 0 1-.708-.708L10.293 8.5H4.5A.5.5 0 0 1 4 8z"/>
                            </svg>
                        </a>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <section class="caei-home-info" aria-labelledby="login-help">
        <div class="caei-workspace-mark" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <div>
            <h2 id="login-help" class="h5 caei-data-key">Before you continue</h2>
            <p class="text-muted small mb-0">
                You will leave this site briefly to authenticate with UC Davis CAS, then return here.
            </p>
        </div>
    </section>
</div>
