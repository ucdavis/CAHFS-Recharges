@{
    var integration = ViewData["Integration"] as string;
    var integrationAuthorized = ViewData["IntegrationAuthorized"] as bool? == true;
    var hasIntegration = !string.IsNullOrEmpty(integration) && integrationAuthorized;
    var pageTitle = ViewData["Title"] as string ?? "CAEI";

    // Theme (--theme-primary) only after workspace authorization succeeds
    var themeClass = hasIntegration
        ? integration?.ToUpperInvariant() switch
        {
            "CAHFS" => "cahfs-theme gparc-theme",
            "EQUINE" => "equine-theme gpare-theme",
            _ => ""
        }
        : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.PathBase}/")" />
    <title>@pageTitle - CAHFS Integration Hub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" />
    <link rel="stylesheet" href="~/CAHFS Recharges.styles.css" asp-append-version="true" />
    <script src="~/js/caei-density.js" asp-append-version="true" defer></script>
    <script src="~/js/caei-keys.js" asp-append-version="true" defer></script>
</head>
<body class="@themeClass">
    <div id="global-progress-bar" class="caei-progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" aria-label="Processing" aria-hidden="true"></div>
    <a href="#main-content" class="visually-hidden-focusable">Skip to main content</a>
    
    @await Html.PartialAsync("_Header")

    <main id="main-content" role="main" class="@(hasIntegration ? "container-fluid py-3 px-4" : "container py-3")" tabindex="-1">
        @RenderBody()
    </main>

    <footer class="caei-footer text-center">
        <div class="container">
            <small>CAHFS Integration Hub</small>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/caei-filter.js" asp-append-version="true"></script>
    <script src="~/js/caei-field-error.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>