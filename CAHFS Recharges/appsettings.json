{
	"Logging": {
		"LogLevel": {
			"Default": "Warning",
			"System": "Warning",
			"Microsoft.AspNetCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"IPAddressAllowlistConfiguration": {
		"InternalAllowlist": [
			"::1",
			"127.0.0.1"
		],
		"ExternalAllowlist": []
	},
	"LoggingPath": "C:\\nlog",
	"Cas": {
		"CasBaseUrl": "https://cas.ucdavis.edu/cas/"
	},
	"Hangfire": {
		"AllowManualWeeklySend": true,
		"OverrideAccountingDateToTodayIfClosed": true,
		"Enabled": true,
		"PrepareSchemaIfNecessary": false,
		"CronDaily": "0 2 * * *",
		"CronWednesday": "0 3 * * 3",
		"TimeZone": "America/Los_Angeles",
		"ValidationBatchSize": 250,
		"ValidationMaxParallelCalls": 5,
		"MaxBatchesPerRun": 50,
		"StatusPollInitialSeconds": 30,
		"StatusPollMaxAttempts": 8,
		"StatusPollMaxSeconds": 3600
	}
}
